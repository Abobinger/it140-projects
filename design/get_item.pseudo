# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

   DEFINE rooms with items and what the items are 
    # Consider the current room, item in that room, and player's inventory.

    PRINT that there is an item on the floor 

    INPUT if user wants to pickup item

    IF input == pickup "item"
            PRINT item that is picked up and what is on it 

    IF input == item in another room
           PRINT that the item they entered is in said room 

   ELSE
          PRINt that they left the item on the floor 

   RETURN back to get another decision if there is an item

END get_item


